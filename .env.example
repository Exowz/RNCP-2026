# --- Concorde : variables d'environnement (copier en .env, jamais versionne) ---

# API data (C5)
CONCORDE_DATA_API_HOST=127.0.0.1
CONCORDE_DATA_API_PORT=8001

# API modele (C9)
CONCORDE_MODEL_API_HOST=127.0.0.1
CONCORDE_MODEL_API_PORT=8002

# Application (C10)
CONCORDE_APP_HOST=127.0.0.1
CONCORDE_APP_PORT=8000
# URL interne appelee par l'app -> prouve que l'app consomme reellement l'API (C10)
CONCORDE_MODEL_API_URL=http://127.0.0.1:8002

# Cles d'API : valeurs de developpement, a regenerer en pre-production (C17)
# Format : "<cle>:<role>" separes par des virgules. Roles : reader | analyst | admin
CONCORDE_API_KEYS=dev-reader-key:reader,dev-analyst-key:analyst,dev-admin-key:admin

# Base PostgreSQL locale (C4) - conteneur Docker
CONCORDE_PG_HOST=127.0.0.1
CONCORDE_PG_PORT=5433
CONCORDE_PG_DB=concorde
CONCORDE_PG_USER=concorde
CONCORDE_PG_PASSWORD=change-me-in-local-env

# Mode hors ligne : si true, toute tentative d'appel reseau sortant leve une erreur (demo)
CONCORDE_OFFLINE=true

# Journalisation (C20)
CONCORDE_LOG_LEVEL=INFO
CONCORDE_LOG_DIR=monitoring/logs
